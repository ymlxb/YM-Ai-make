# Server
PORT=7001
MOCK_MODE=false
CORS_ORIGIN=http://localhost:3000

# Main model: deepseek | glm
MAIN_MODEL_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# GLM
GLM_API_KEY=
GLM_MODEL=glm-5.2
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# Qwen vision model
QWEN_API_KEY=
QWEN_MODEL=qwen-vl-max
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Figma 官方 REST API（免费方案，无需 Figma Desktop / 付费 Dev Mode）
# 获取令牌（免费）：Figma 账户设置 → Security → Personal access tokens → Generate new token
FIGMA_API_KEY=

# 旧版 Figma Desktop MCP 配置（已弃用，保留兼容）
# FIGMA_MCP_URL=http://127.0.0.1:3845/mcp
# FIGMA_MCP_SERVER_URL=http://127.0.0.1:3845/mcp

# Aliyun OSS
ALI_OSS_AK=
ALI_OSS_SK=
ALI_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
ALI_OSS_BUCKET=
